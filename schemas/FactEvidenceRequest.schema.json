{
  "$defs": {
    "CandidateReviewData": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "format": "uuid",
          "title": "Source Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "result_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Hash",
          "type": "string"
        },
        "candidate_index": {
          "minimum": 0,
          "title": "Candidate Index",
          "type": "integer"
        },
        "expected_review_revision": {
          "minimum": 0,
          "title": "Expected Review Revision",
          "type": "integer"
        },
        "disposition": {
          "enum": [
            "ADMIT",
            "REJECT"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "statement": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "subjects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Subjects",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "run_id",
        "result_hash",
        "candidate_index",
        "expected_review_revision",
        "disposition"
      ],
      "title": "CandidateReviewData",
      "type": "object"
    },
    "CommandMeta": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "expected_case_sequence": {
          "minimum": 0,
          "title": "Expected Case Sequence",
          "type": "integer"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "tenant_id",
        "case_id",
        "idempotency_key",
        "expected_case_sequence",
        "correlation_id"
      ],
      "title": "CommandMeta",
      "type": "object"
    },
    "ConfirmFactData": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "decision"
      ],
      "title": "ConfirmFactData",
      "type": "object"
    },
    "EvidenceEditData": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "authenticity": {
          "anyOf": [
            {
              "enum": [
                "UNKNOWN",
                "VERIFIED",
                "DISPUTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authenticity"
        },
        "submitted_in": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EvidenceEditData",
      "type": "object"
    },
    "FactEditData": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement"
        },
        "support": {
          "anyOf": [
            {
              "enum": [
                "SOURCE_BACKED",
                "INFERRED",
                "UNSUPPORTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support"
        },
        "evidence": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Ref"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "subjects": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Ref"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subjects"
        },
        "event_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Date"
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key_fact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Fact"
        }
      },
      "title": "FactEditData",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "TransitionData": {
      "additionalProperties": false,
      "properties": {},
      "title": "TransitionData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "urn:lukart:work:FactEvidenceRequest:1.0.0",
      "title": "Contract",
      "type": "string"
    },
    "operation": {
      "enum": [
        "ReviewCandidate",
        "MarkFactExtracted",
        "ReviewFact",
        "ConfirmFact",
        "DisputeFact",
        "RejectFact",
        "UpdateFact",
        "ReviewEvidence",
        "AcceptEvidence",
        "ChallengeEvidence",
        "ExcludeEvidence",
        "UpdateEvidence"
      ],
      "title": "Operation",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/CommandMeta"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateReviewData"
        },
        {
          "$ref": "#/$defs/ConfirmFactData"
        },
        {
          "$ref": "#/$defs/FactEditData"
        },
        {
          "$ref": "#/$defs/EvidenceEditData"
        },
        {
          "$ref": "#/$defs/TransitionData"
        }
      ],
      "title": "Data"
    },
    "inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Inputs",
      "type": "array"
    },
    "anchors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceAnchor"
      },
      "title": "Anchors",
      "type": "array"
    },
    "rationale": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "operation",
    "meta",
    "data",
    "rationale"
  ],
  "title": "FactEvidenceRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:FactEvidenceRequest:1.0.0"
}
