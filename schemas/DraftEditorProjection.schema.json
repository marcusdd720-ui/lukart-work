{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Draft": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "previous_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Hash"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "kind": {
          "const": "Draft",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "PLANNED",
            "GENERATED",
            "VALIDATED",
            "APPROVED",
            "RENDERED",
            "CERTIFIED"
          ],
          "title": "Status",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/Ref"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionText"
          },
          "title": "Sections",
          "type": "array"
        },
        "reproduction": {
          "$ref": "#/$defs/ReproductionManifest"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "id",
        "tenant_id",
        "case_id",
        "revision",
        "previous_hash",
        "created_at",
        "recorded_at",
        "provenance",
        "kind",
        "status",
        "plan",
        "snapshot_id",
        "snapshot_hash",
        "sections",
        "reproduction"
      ],
      "title": "Draft",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "MANUAL",
            "EXTRACTION",
            "DERIVATION",
            "IMPORT",
            "VALIDATION"
          ],
          "title": "Method",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Inputs",
          "type": "array"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionPin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "actor",
        "operation_id",
        "method",
        "inputs",
        "anchors",
        "rationale"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ReproductionManifest": {
      "additionalProperties": false,
      "properties": {
        "knowledge": {
          "items": {
            "$ref": "#/$defs/VersionPin"
          },
          "title": "Knowledge",
          "type": "array"
        },
        "rule_set": {
          "$ref": "#/$defs/VersionPin"
        },
        "prompts": {
          "items": {
            "$ref": "#/$defs/VersionPin"
          },
          "title": "Prompts",
          "type": "array"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/VersionPin"
          },
          "title": "Models",
          "type": "array"
        },
        "provider": {
          "$ref": "#/$defs/VersionPin"
        },
        "model_parameters_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Parameters Hash",
          "type": "string"
        },
        "generator": {
          "$ref": "#/$defs/VersionPin"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/VersionPin"
          },
          "title": "Validators",
          "type": "array"
        },
        "render_profile": {
          "$ref": "#/$defs/VersionPin"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "raw_output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Output Hash",
          "type": "string"
        }
      },
      "required": [
        "knowledge",
        "rule_set",
        "prompts",
        "models",
        "provider",
        "model_parameters_hash",
        "generator",
        "validators",
        "render_profile",
        "input_hash",
        "raw_output_hash"
      ],
      "title": "ReproductionManifest",
      "type": "object"
    },
    "SectionText": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "$ref": "#/$defs/Ref"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "minItems": 1,
          "title": "Statements",
          "type": "array"
        }
      },
      "required": [
        "section",
        "statements"
      ],
      "title": "SectionText",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "statement_type": {
          "enum": [
            "FACTUAL",
            "LEGAL",
            "REQUEST",
            "INFERENCE",
            "STRUCTURAL"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "support": {
          "enum": [
            "SOURCE_BACKED",
            "INFERRED",
            "UNSUPPORTED"
          ],
          "title": "Support",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Citations",
          "type": "array"
        },
        "inference_label": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Label"
        }
      },
      "required": [
        "id",
        "text",
        "statement_type",
        "support",
        "refs",
        "citations"
      ],
      "title": "Statement",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result_type": {
      "const": "DRAFT_EDITOR",
      "default": "DRAFT_EDITOR",
      "title": "Result Type",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/Draft"
    },
    "draft_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Hash",
      "type": "string"
    },
    "case_sequence": {
      "minimum": 1,
      "title": "Case Sequence",
      "type": "integer"
    },
    "validation_policy": {
      "$ref": "#/$defs/VersionPin"
    },
    "semantic_profile": {
      "$ref": "#/$defs/VersionPin"
    },
    "editable": {
      "title": "Editable",
      "type": "boolean"
    },
    "review_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Id"
    },
    "validation_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Run Id"
    },
    "render_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Render Id"
    }
  },
  "required": [
    "draft",
    "draft_hash",
    "case_sequence",
    "validation_policy",
    "semantic_profile",
    "editable"
  ],
  "title": "DraftEditorProjection",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:DraftEditorProjection:1.0.0"
}
