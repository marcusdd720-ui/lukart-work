{
  "additionalProperties": false,
  "description": "Deployment-supplied package provenance; no Git state is guessed at runtime.",
  "properties": {
    "profile_id": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "version": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "build_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Build Revision",
      "type": "string"
    },
    "baseline_contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Contract Hash",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "version",
    "build_revision",
    "baseline_contract_hash"
  ],
  "title": "FinalPackageProfile",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:FinalPackageProfile:1.0.0"
}
