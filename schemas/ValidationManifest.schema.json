{
  "$defs": {
    "JsonValue": {},
    "ProceduralDatum": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "classification": {
          "enum": [
            "FACT",
            "CLAIM",
            "HYPOTHESIS",
            "INTERPRETATION",
            "UNKNOWN",
            "UNRESOLVED"
          ],
          "title": "Classification",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "key",
        "classification"
      ],
      "title": "ProceduralDatum",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/VersionPin"
    },
    "draft_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Hash",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "dependency_hashes": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "$ref": "#/$defs/Ref"
          },
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        ],
        "type": "array"
      },
      "title": "Dependency Hashes",
      "type": "array"
    },
    "review_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Review Hash"
    },
    "evaluation_date": {
      "format": "date",
      "title": "Evaluation Date",
      "type": "string"
    },
    "procedural_context": {
      "items": {
        "$ref": "#/$defs/ProceduralDatum"
      },
      "title": "Procedural Context",
      "type": "array"
    }
  },
  "required": [
    "policy",
    "draft_hash",
    "snapshot_hash",
    "dependency_hashes",
    "review_hash",
    "evaluation_date",
    "procedural_context"
  ],
  "title": "ValidationManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:ValidationManifest:1.0.0"
}
