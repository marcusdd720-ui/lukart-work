          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "version": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "document_type": {
      "$ref": "#/$defs/VersionPin"
    },
    "header": {
      "maxLength": 20000,
      "minLength": 1,
