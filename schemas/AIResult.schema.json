{
  "$defs": {
    "AIProposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "format": "uuid",
          "title": "Proposal Id",
          "type": "string"
        },
        "proposed_kind": {
          "enum": [
            "Fact",
            "Evidence",
            "Issue",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Risk"
          ],
          "title": "Proposed Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "support": {
          "enum": [
            "SOURCE_BACKED",
            "INFERRED",
            "UNSUPPORTED"
          ],
          "title": "Support",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "uncertainty": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ],
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "proposed_kind",
        "statement",
        "support",
        "source_refs",
        "anchors",
        "uncertainty"
      ],
      "title": "AIProposal",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SectionText": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "$ref": "#/$defs/Ref"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "minItems": 1,
          "title": "Statements",
          "type": "array"
        }
      },
      "required": [
        "section",
        "statements"
      ],
      "title": "SectionText",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "statement_type": {
          "enum": [
            "FACTUAL",
            "LEGAL",
            "REQUEST",
            "INFERENCE",
            "STRUCTURAL"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "support": {
          "enum": [
            "SOURCE_BACKED",
            "INFERRED",
            "UNSUPPORTED"
          ],
          "title": "Support",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Citations",
          "type": "array"
        },
        "inference_label": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Label"
        }
      },
      "required": [
        "id",
        "text",
        "statement_type",
        "support",
        "refs",
        "citations"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "PROPOSE",
        "ABSTAIN"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "proposals": {
      "items": {
        "$ref": "#/$defs/AIProposal"
      },
      "title": "Proposals",
      "type": "array"
    },
    "section": {
      "anyOf": [
        {
          "$ref": "#/$defs/SectionText"
        },
        {
          "type": "null"
        }
      ]
    },
    "missing_information": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    }
  },
  "required": [
    "request_id",
    "snapshot_hash",
    "disposition",
    "proposals",
    "section",
    "missing_information",
    "reason"
  ],
  "title": "AIResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:AIResult:1.0.0"
}
