{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "LEGAL_SUPPORT",
            "FACTUAL_SUPPORT",
            "EVIDENCE_SUPPORT",
            "COUNTERARGUMENT_EXPOSURE",
            "PROCEDURAL_RELEVANCE",
            "OVERALL_CONFIDENCE"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "level": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ],
          "title": "Level",
          "type": "string"
        },
        "basis": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Basis",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "level",
        "basis",
        "rationale"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "MANUAL",
            "EXTRACTION",
            "DERIVATION",
            "IMPORT",
            "VALIDATION"
          ],
          "title": "Method",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Inputs",
          "type": "array"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionPin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "actor",
        "operation_id",
        "method",
        "inputs",
        "anchors",
        "rationale"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "previous_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "kind": {
      "const": "Argument",
      "title": "Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "REVIEWED",
        "ADOPTED",
        "CHALLENGED",
        "WITHDRAWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Ref"
    },
    "polarity": {
      "enum": [
        "SUPPORTS",
        "OPPOSES"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "conclusion": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Conclusion",
      "type": "string"
    },
    "premises": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "minItems": 1,
      "title": "Premises",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Rules",
      "type": "array"
    },
    "support": {
      "enum": [
        "SOURCE_BACKED",
        "INFERRED",
        "UNSUPPORTED"
      ],
      "title": "Support",
      "type": "string"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/Assessment"
      },
      "title": "Assessments",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "case_id",
    "revision",
    "previous_hash",
    "created_at",
    "recorded_at",
    "provenance",
    "kind",
    "status",
    "target",
    "polarity",
    "conclusion",
    "premises",
    "rules",
    "support",
    "assessments"
  ],
  "title": "Argument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:Argument:1.0.0"
}
