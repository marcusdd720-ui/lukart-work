{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "MANUAL",
            "EXTRACTION",
            "DERIVATION",
            "IMPORT",
            "VALIDATION"
          ],
          "title": "Method",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Inputs",
          "type": "array"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionPin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "actor",
        "operation_id",
        "method",
        "inputs",
        "anchors",
        "rationale"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "previous_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "kind": {
      "const": "Deadline",
      "title": "Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "UNKNOWN",
        "CALCULATED",
        "VERIFIED",
        "SATISFIED",
        "EXPIRED",
        "CANCELLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "proceeding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "filing": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trigger": {
      "$ref": "#/$defs/Ref"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Rules",
      "type": "array"
    },
    "due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due At"
    },
    "timezone": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    },
    "calendar_pin": {
      "$ref": "#/$defs/VersionPin"
    },
    "computation_trace": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Computation Trace",
      "type": "array"
    },
    "satisfaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "id",
    "tenant_id",
    "case_id",
    "revision",
    "previous_hash",
    "created_at",
    "recorded_at",
    "provenance",
    "kind",
    "status",
    "trigger",
    "rules",
    "timezone",
    "calendar_pin",
    "computation_trace"
  ],
  "title": "Deadline",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:Deadline:1.0.0"
}
