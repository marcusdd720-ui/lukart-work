{
  "$defs": {
    "FinalStatementTrace": {
      "additionalProperties": false,
      "properties": {
        "statement_id": {
          "format": "uuid",
          "title": "Statement Id",
          "type": "string"
        },
        "section": {
          "$ref": "#/$defs/Ref"
        },
        "statement_type": {
          "enum": [
            "FACTUAL",
            "LEGAL",
            "REQUEST",
            "INFERENCE",
            "STRUCTURAL"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "statement_id",
        "section",
        "statement_type",
        "refs",
        "citations"
      ],
      "title": "FinalStatementTrace",
      "type": "object"
    },
    "FinalTraceNode": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Links",
          "type": "array"
        },
        "anchors": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "title": "Anchors",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "content_hash",
        "links",
        "anchors"
      ],
      "title": "FinalTraceNode",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "urn:lukart:work:FinalEvidenceMap:1.0.0",
      "title": "Contract",
      "type": "string"
    },
    "statements": {
      "items": {
        "$ref": "#/$defs/FinalStatementTrace"
      },
      "title": "Statements",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/FinalTraceNode"
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": [
    "contract",
    "statements",
    "nodes"
  ],
  "title": "FinalEvidenceMap",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:FinalEvidenceMap:1.0.0"
}
