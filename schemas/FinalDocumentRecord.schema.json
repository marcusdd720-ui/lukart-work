{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "schema",
            "facts",
            "evidence",
            "legal_basis",
            "procedure",
            "contradictions",
            "citations",
            "requests",
            "language",
            "document",
            "adversarial",
            "render"
          ],
          "title": "Check",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "validator": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "check",
        "outcome",
        "validator"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Draft": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "previous_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Hash"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "kind": {
          "const": "Draft",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "PLANNED",
            "GENERATED",
            "VALIDATED",
            "APPROVED",
            "RENDERED",
            "CERTIFIED"
          ],
          "title": "Status",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/Ref"
        },
        "snapshot_id": {
          "format": "uuid",
          "title": "Snapshot Id",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionText"
          },
          "title": "Sections",
          "type": "array"
        },
        "reproduction": {
          "$ref": "#/$defs/ReproductionManifest"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "id",
        "tenant_id",
        "case_id",
        "revision",
        "previous_hash",
        "created_at",
        "recorded_at",
        "provenance",
        "kind",
        "status",
        "plan",
        "snapshot_id",
        "snapshot_hash",
        "sections",
        "reproduction"
      ],
      "title": "Draft",
      "type": "object"
    },
    "FinalPackageProfile": {
      "additionalProperties": false,
      "description": "Deployment-supplied package provenance; no Git state is guessed at runtime.",
      "properties": {
        "profile_id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "build_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Build Revision",
          "type": "string"
        },
        "baseline_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Contract Hash",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "version",
        "build_revision",
        "baseline_contract_hash"
      ],
      "title": "FinalPackageProfile",
      "type": "object"
    },
    "JsonValue": {},
    "LayoutBlock": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "DOCUMENT_HEADER",
            "PARTY_BLOCK",
            "REQUEST_HEADING",
            "REQUEST_ITEM",
            "SECTION_HEADING",
            "BODY",
            "LEGAL_BASIS",
            "QUOTE",
            "SIGNATURE",
            "ATTACHMENT_HEADING",
            "ATTACHMENT_ITEM"
          ],
          "title": "Role",
          "type": "string"
        },
        "style_token": {
          "enum": [
            "document.heading.primary",
            "document.heading.secondary",
            "document.party_block",
            "document.request",
            "document.body",
            "document.legal_basis",
            "document.quote",
            "document.signature",
            "document.attachment"
          ],
          "title": "Style Token",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "ordinal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        }
      },
      "required": [
        "role",
        "style_token",
        "text"
      ],
      "title": "LayoutBlock",
      "type": "object"
    },
    "LayoutTree": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
