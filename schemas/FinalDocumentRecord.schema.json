          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "case_id",
        "draft",
        "snapshot_hash",
        "authority",
        "profile",
        "blocks"
      ],
      "title": "LayoutTree",
