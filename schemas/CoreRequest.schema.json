{
  "$defs": {
    "CommandMeta": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "expected_case_sequence": {
          "minimum": 0,
          "title": "Expected Case Sequence",
          "type": "integer"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "tenant_id",
        "case_id",
        "idempotency_key",
        "expected_case_sequence",
        "correlation_id"
      ],
      "title": "CommandMeta",
      "type": "object"
    },
    "JsonValue": {},
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "urn:lukart:work:CoreRequest:1.0.0",
      "title": "Contract",
      "type": "string"
    },
    "operation": {
      "enum": [
        "CreateCase",
        "EditCase",
        "SuspendCase",
        "CloseCase",
        "ReopenCase",
        "ArchiveCase",
        "AddParty",
        "EditParty",
        "VerifyParty",
        "DisputeParty",
        "AddInstitution",
        "AddProceeding",
        "AddFiling",
        "AddEvidence",
        "AddFact",
        "EditFact",
        "ReviewFact",
        "ConfirmFact",
        "DisputeFact",
        "AddIssue",
        "AddClaim",
        "AddRequest",
        "AddSection",
        "PrepareSection",
        "AddPlan",
        "ReviewPlan",
        "ApprovePlan",
        "RecordDecision",
        "RevokeDecision",
        "RegisterSource",
        "CreateSnapshot",
        "AcceptSnapshot",
        "GenerateDocument",
        "ValidateDraft",
        "RequestRelease"
      ],
      "title": "Operation",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/CommandMeta"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Data",
      "type": "object"
    },
    "inputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Inputs",
      "type": "array"
    },
    "anchors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceAnchor"
      },
      "title": "Anchors",
      "type": "array"
    },
    "rationale": {
      "default": "Manual Case Core operation",
      "maxLength": 20000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "operation",
    "meta"
  ],
  "title": "CoreRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:CoreRequest:1.0.0"
}
