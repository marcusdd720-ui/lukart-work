{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "schema",
            "facts",
            "evidence",
            "legal_basis",
            "procedure",
            "contradictions",
            "citations",
            "requests",
            "language",
            "document",
            "adversarial",
            "render"
          ],
          "title": "Check",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "validator": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "check",
        "outcome",
        "validator"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ReviewAssessment": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "facts",
            "evidence",
            "legal_basis",
            "procedure",
            "contradictions",
            "language",
            "adversarial"
          ],
          "title": "Check",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "check",
        "outcome",
        "rationale"
      ],
      "title": "ReviewAssessment",
      "type": "object"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "facts",
            "evidence",
            "legal_basis",
            "procedure",
            "contradictions",
            "language",
            "adversarial"
          ],
          "title": "Check",
          "type": "string"
        },
        "code": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "BLOCKER",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "message": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "check",
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "ValidationExecution": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/ValidationRun"
        },
        "output_draft": {
          "$ref": "#/$defs/Ref"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "evaluation_date": {
          "format": "date",
          "title": "Evaluation Date",
          "type": "string"
        },
        "input_sequence": {
          "minimum": 1,
          "title": "Input Sequence",
          "type": "integer"
        },
        "committed_sequence": {
          "minimum": 1,
          "title": "Committed Sequence",
          "type": "integer"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidationReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "validator": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "id",
        "run",
        "output_draft",
        "output_hash",
        "evaluation_date",
        "input_sequence",
        "committed_sequence",
        "review",
        "dependencies",
        "validator"
      ],
      "title": "ValidationExecution",
      "type": "object"
    },
    "ValidationReview": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/Ref"
        },
        "draft_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Hash",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/VersionPin"
        },
        "evaluation_date": {
          "format": "date",
          "title": "Evaluation Date",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/ReviewAssessment"
          },
          "title": "Assessments",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ReviewIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "case_id",
        "draft",
        "draft_hash",
        "snapshot_hash",
        "policy",
        "evaluation_date",
        "actor",
        "recorded_at",
        "assessments",
        "issues",
        "rationale"
      ],
      "title": "ValidationReview",
      "type": "object"
    },
    "ValidationRun": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/Ref"
        },
        "draft_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Hash",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/VersionPin"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Findings",
          "type": "array"
        },
        "render_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Render Hashes",
          "type": "array"
        },
        "execution_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Manifest Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "case_id",
        "draft",
        "draft_hash",
        "snapshot_hash",
        "policy",
        "completed_at",
        "checks",
        "findings",
        "render_hashes",
        "execution_manifest_hash"
      ],
      "title": "ValidationRun",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution": {
      "$ref": "#/$defs/ValidationExecution"
    },
    "freshness": {
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN"
      ],
      "title": "Freshness",
      "type": "string"
    },
    "eligible_for_approval": {
      "title": "Eligible For Approval",
      "type": "boolean"
    },
    "reasons": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    }
  },
  "required": [
    "execution",
    "freshness",
    "eligible_for_approval",
    "reasons"
  ],
  "title": "ValidationProjection",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:ValidationProjection:1.0.0"
}
