{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AuditEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "operation": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "command_id": {
          "format": "uuid",
          "title": "Command Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "previous_event_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Event Hash"
        },
        "source_versions": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Source Versions",
          "type": "array"
        },
        "model_provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionPin"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_version": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "event_id",
        "tenant_id",
        "case_id",
        "sequence",
        "actor",
        "timestamp",
        "operation",
        "command_id",
        "correlation_id",
        "input_hash",
        "output_hash",
        "previous_event_hash",
        "source_versions",
        "model_provider",
        "rule_version"
      ],
      "title": "AuditEvent",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "enum": [
        "RevisionAppended",
        "SnapshotAccepted",
        "PlanApproved",
        "DraftGenerated",
        "DraftingAbstained",
        "DraftingRejected",
        "DependenciesInvalidated",
        "ValidationCompleted",
        "ReleaseDenied",
        "ReleaseGranted",
        "DecisionRecorded",
        "FinalPackageAssembled"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "audit": {
      "$ref": "#/$defs/AuditEvent"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Subjects",
      "type": "array"
    }
  },
  "required": [
    "event_type",
    "audit",
    "subjects"
  ],
  "title": "DomainEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:DomainEvent:2.0.0"
}
