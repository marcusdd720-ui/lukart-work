{
  "$defs": {
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SectionText": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "$ref": "#/$defs/Ref"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "minItems": 1,
          "title": "Statements",
          "type": "array"
        }
      },
      "required": [
        "section",
        "statements"
      ],
      "title": "SectionText",
      "type": "object"
    },
    "SemanticDocument": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/Ref"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "header": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Header",
          "type": "string"
        },
        "parties": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Parties",
          "type": "array"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Requests",
          "type": "array"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionText"
          },
          "title": "Sections",
          "type": "array"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/SourceAnchor"
          },
          "title": "Attachments",
          "type": "array"
        },
        "signature_party": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tenant_id",
        "case_id",
        "draft",
        "snapshot_hash",
        "header",
        "parties",
        "requests",
        "sections",
        "attachments",
        "signature_party"
      ],
      "title": "SemanticDocument",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "statement_type": {
          "enum": [
            "FACTUAL",
            "LEGAL",
            "REQUEST",
            "INFERENCE",
            "STRUCTURAL"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "support": {
          "enum": [
            "SOURCE_BACKED",
            "INFERRED",
            "UNSUPPORTED"
          ],
          "title": "Support",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Refs",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Citations",
          "type": "array"
        },
        "inference_label": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Label"
        }
      },
      "required": [
        "id",
        "text",
        "statement_type",
        "support",
        "refs",
        "citations"
      ],
      "title": "Statement",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document": {
      "$ref": "#/$defs/SemanticDocument"
    },
    "profile": {
      "$ref": "#/$defs/VersionPin"
    },
    "authorization_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authorization Hash",
      "type": "string"
    }
  },
  "required": [
    "document",
    "profile",
    "authorization_hash"
  ],
  "title": "RenderRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:RenderRequest:1.0.0"
}
