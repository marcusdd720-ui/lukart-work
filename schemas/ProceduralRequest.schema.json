          "maxLength": 20000,
          "minLength": 1,
          "title": "Trigger Key",
          "type": "string"
        },
        "offset_days": {
          "minimum": 0,
          "title": "Offset Days",
          "type": "integer"
        },
        "timezone": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "due_time": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Due Time",
          "type": "string"
        },
        "calendar_mode": {
          "enum": [
            "CALENDAR_DAYS",
            "BUSINESS_DAYS"
          ],
