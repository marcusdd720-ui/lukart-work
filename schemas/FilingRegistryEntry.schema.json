{
  "$defs": {
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "filing": {
      "$ref": "#/$defs/Ref"
    },
    "direction": {
      "enum": [
        "INCOMING",
        "OUTGOING"
      ],
      "title": "Direction",
      "type": "string"
    },
    "status": {
      "enum": [
        "PLANNED",
        "PREPARING",
        "READY",
        "SUBMITTED",
        "ACKNOWLEDGED",
        "WITHDRAWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "document_type": {
      "$ref": "#/$defs/VersionPin"
    },
    "proceeding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipient": {
      "$ref": "#/$defs/Ref"
    },
    "authors": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Authors",
      "type": "array"
    },
    "artifact_source_id": {
      "format": "uuid",
      "title": "Artifact Source Id",
      "type": "string"
    },
    "artifact_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Hash",
      "type": "string"
    },
    "artifact_byte_length": {
      "minimum": 0,
      "title": "Artifact Byte Length",
      "type": "integer"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Submitted At"
    },
    "submission_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAnchor"
        },
        {
          "type": "null"
        }
      ]
    },
    "submission_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "acknowledgement_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAnchor"
        },
        {
          "type": "null"
        }
      ]
    },
    "acknowledgement_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_count": {
      "minimum": 1,
      "title": "Receipt Count",
      "type": "integer"
    }
  },
  "required": [
    "filing",
    "direction",
    "status",
    "document_type",
    "proceeding",
    "recipient",
    "authors",
    "artifact_source_id",
    "artifact_hash",
    "artifact_byte_length",
    "submitted_at",
    "submission_receipt",
    "submission_evidence",
    "acknowledgement_receipt",
    "acknowledgement_evidence",
    "receipt_count"
  ],
  "title": "FilingRegistryEntry",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:FilingRegistryEntry:1.0.0"
}
