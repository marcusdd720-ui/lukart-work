{
  "$defs": {
    "FreshnessAssessment": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/Ref"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "current_case_sequence": {
          "minimum": 1,
          "title": "Current Case Sequence",
          "type": "integer"
        },
        "state": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ],
          "title": "State",
          "type": "string"
        },
        "changed_inputs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Changed Inputs",
          "type": "array"
        }
      },
      "required": [
        "target",
        "snapshot_hash",
        "current_case_sequence",
        "state",
        "changed_inputs"
      ],
      "title": "FreshnessAssessment",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result_type": {
      "const": "AFFECTED_DRAFTS",
      "title": "Result Type",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "case_sequence": {
      "minimum": 1,
      "title": "Case Sequence",
      "type": "integer"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/FreshnessAssessment"
      },
      "title": "Assessments",
      "type": "array"
    }
  },
  "required": [
    "result_type",
    "tenant_id",
    "case_id",
    "case_sequence",
    "assessments"
  ],
  "title": "AffectedDraftsResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:AffectedDraftsResult:1.0.0"
}
