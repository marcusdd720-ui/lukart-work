{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "schema",
            "facts",
            "evidence",
            "legal_basis",
            "procedure",
            "contradictions",
            "citations",
            "requests",
            "language",
            "document",
            "adversarial",
            "render"
          ],
          "title": "Check",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "validator": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "check",
        "outcome",
        "validator"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "FinalizationApproval": {
      "additionalProperties": false,
      "properties": {
        "render_id": {
          "format": "uuid",
          "title": "Render Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "rendered_draft": {
          "$ref": "#/$defs/Ref"
        },
        "rendered_draft_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Draft Hash",
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/Ref"
        },
        "approval_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Hash",
          "type": "string"
        },
        "post_render_run": {
          "$ref": "#/$defs/ValidationRun"
        },
        "manifest": {
          "$ref": "#/$defs/PostRenderManifest"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "committed_sequence": {
          "title": "Committed Sequence",
          "type": "integer"
        }
      },
      "required": [
        "render_id",
        "tenant_id",
        "case_id",
        "rendered_draft",
        "rendered_draft_hash",
        "approval",
        "approval_hash",
        "post_render_run",
        "manifest",
        "actor",
        "recorded_at",
        "committed_sequence"
      ],
      "title": "FinalizationApproval",
      "type": "object"
    },
    "JsonValue": {},
    "PostRenderManifest": {
      "additionalProperties": false,
      "properties": {
        "input_validation": {
          "$ref": "#/$defs/ValidationRunPin"
        },
        "input_validation_projection_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Validation Projection Hash",
          "type": "string"
        },
        "render_receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Render Receipt Hash",
          "type": "string"
        },
        "rendered_draft": {
          "$ref": "#/$defs/Ref"
        },
        "rendered_draft_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Draft Hash",
          "type": "string"
        },
        "approval": {
          "$ref": "#/$defs/Ref"
        },
        "approval_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Hash",
          "type": "string"
        },
        "artifacts": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/RenderArtifact"
            },
            {
              "$ref": "#/$defs/RenderArtifact"
            }
          ],
          "title": "Artifacts",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "input_validation",
        "input_validation_projection_hash",
        "render_receipt_hash",
        "rendered_draft",
        "rendered_draft_hash",
        "approval",
        "approval_hash",
        "artifacts",
        "policy"
      ],
      "title": "PostRenderManifest",
      "type": "object"
    },
    "ProceduralDatum": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "classification": {
          "enum": [
            "FACT",
            "CLAIM",
            "HYPOTHESIS",
            "INTERPRETATION",
            "UNKNOWN",
            "UNRESOLVED"
          ],
          "title": "Classification",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "key",
        "classification"
      ],
      "title": "ProceduralDatum",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "RenderArtifact": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "DOCX",
            "PDF"
          ],
          "title": "Format",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/pdf"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "byte_length": {
          "minimum": 1,
          "title": "Byte Length",
          "type": "integer"
        }
      },
      "required": [
        "format",
        "media_type",
        "content_hash",
        "byte_length"
      ],
      "title": "RenderArtifact",
      "type": "object"
    },
    "ReviewAssessment": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "facts",
            "evidence",
            "legal_basis",
            "procedure",
            "contradictions",
            "language",
            "adversarial"
          ],
          "title": "Check",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "check",
        "outcome",
        "rationale"
      ],
      "title": "ReviewAssessment",
      "type": "object"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "enum": [
            "facts",
            "evidence",
            "legal_basis",
            "procedure",
            "contradictions",
            "language",
            "adversarial"
          ],
          "title": "Check",
          "type": "string"
        },
        "code": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "BLOCKER",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "message": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "check",
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "ReviewIssue",
      "type": "object"
    },
    "ValidationExecution": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/ValidationRun"
        },
        "output_draft": {
          "$ref": "#/$defs/Ref"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "evaluation_date": {
          "format": "date",
          "title": "Evaluation Date",
          "type": "string"
        },
        "input_sequence": {
          "minimum": 1,
          "title": "Input Sequence",
          "type": "integer"
        },
        "committed_sequence": {
          "minimum": 1,
          "title": "Committed Sequence",
          "type": "integer"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidationReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "validator": {
          "$ref": "#/$defs/VersionPin"
        },
        "manifest": {
          "$ref": "#/$defs/ValidationManifest"
        }
      },
      "required": [
        "id",
        "run",
        "output_draft",
        "output_hash",
        "evaluation_date",
        "input_sequence",
        "committed_sequence",
        "review",
        "dependencies",
        "validator",
        "manifest"
      ],
      "title": "ValidationExecution",
      "type": "object"
    },
    "ValidationManifest": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/VersionPin"
        },
        "draft_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Hash",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "dependency_hashes": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/Ref"
              },
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Dependency Hashes",
          "type": "array"
        },
        "review_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review Hash"
        },
        "evaluation_date": {
          "format": "date",
          "title": "Evaluation Date",
          "type": "string"
        },
        "procedural_context": {
          "items": {
            "$ref": "#/$defs/ProceduralDatum"
          },
          "title": "Procedural Context",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "draft_hash",
        "snapshot_hash",
        "dependency_hashes",
        "review_hash",
        "evaluation_date",
        "procedural_context"
      ],
      "title": "ValidationManifest",
      "type": "object"
    },
    "ValidationProjection": {
      "additionalProperties": false,
      "properties": {
        "execution": {
          "$ref": "#/$defs/ValidationExecution"
        },
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "eligible_for_approval": {
          "title": "Eligible For Approval",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "execution",
        "freshness",
        "eligible_for_approval",
        "reasons"
      ],
      "title": "ValidationProjection",
      "type": "object"
    },
    "ValidationReview": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/Ref"
        },
        "draft_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Hash",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/VersionPin"
        },
        "evaluation_date": {
          "format": "date",
          "title": "Evaluation Date",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/ReviewAssessment"
          },
          "title": "Assessments",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ReviewIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "case_id",
        "draft",
        "draft_hash",
        "snapshot_hash",
        "policy",
        "evaluation_date",
        "actor",
        "recorded_at",
        "assessments",
        "issues",
        "rationale"
      ],
      "title": "ValidationReview",
      "type": "object"
    },
    "ValidationRun": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "draft": {
          "$ref": "#/$defs/Ref"
        },
        "draft_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Hash",
          "type": "string"
        },
        "snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/VersionPin"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Findings",
          "type": "array"
        },
        "render_hashes": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Render Hashes",
          "type": "array"
        },
        "execution_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Manifest Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "case_id",
        "draft",
        "draft_hash",
        "snapshot_hash",
        "policy",
        "completed_at",
        "checks",
        "findings",
        "render_hashes",
        "execution_manifest_hash"
      ],
      "title": "ValidationRun",
      "type": "object"
    },
    "ValidationRunPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "content_hash"
      ],
      "title": "ValidationRunPin",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "urn:lukart:work:FinalValidationRecord:1.0.0",
      "title": "Contract",
      "type": "string"
    },
    "pre_render": {
      "$ref": "#/$defs/ValidationProjection"
    },
    "approval": {
      "$ref": "#/$defs/FinalizationApproval"
    }
  },
  "required": [
    "contract",
    "pre_render",
    "approval"
  ],
  "title": "FinalValidationRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:FinalValidationRecord:1.0.0"
}
