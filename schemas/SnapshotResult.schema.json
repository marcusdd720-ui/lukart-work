{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "case_sequence": {
          "minimum": 1,
          "title": "Case Sequence",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/SnapshotMember"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "heads": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "minItems": 1,
          "title": "Heads",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceDocument"
          },
          "title": "Sources",
          "type": "array"
        },
        "knowledge_pins": {
          "items": {
            "$ref": "#/$defs/VersionPin"
          },
          "title": "Knowledge Pins",
          "type": "array"
        },
        "rule_set": {
          "$ref": "#/$defs/VersionPin"
        },
        "policy": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "schema_version",
        "id",
        "tenant_id",
        "case_id",
        "case_sequence",
        "created_at",
        "members",
        "heads",
        "sources",
        "knowledge_pins",
        "rule_set",
        "policy"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "SnapshotMember": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "content_hash"
      ],
      "title": "SnapshotMember",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "object_key": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Object Key",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "retention_policy": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "case_id",
        "content_hash",
        "media_type",
        "byte_length",
        "object_key",
        "received_at",
        "actor",
        "retention_policy"
      ],
      "title": "SourceDocument",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result_type": {
      "const": "SNAPSHOT",
      "title": "Result Type",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/Snapshot"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "result_type",
    "snapshot",
    "content_hash"
  ],
  "title": "SnapshotResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:SnapshotResult:2.0.0"
}
