{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Case",
            "Party",
            "Institution",
            "Proceeding",
            "Filing",
            "Fact",
            "Evidence",
            "Issue",
            "LegalSource",
            "LegalRule",
            "Claim",
            "Defence",
            "Argument",
            "CounterArgument",
            "Request",
            "Deadline",
            "Risk",
            "Citation",
            "DocumentPlan",
            "Section",
            "Draft",
            "ValidationFinding",
            "Decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/Ref"
    },
    "draft_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Hash",
      "type": "string"
    },
    "render_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Render Hashes",
      "type": "array"
    }
  },
  "required": [
    "tenant_id",
    "case_id",
    "snapshot_id",
    "snapshot_hash",
    "draft",
    "draft_hash",
    "render_hashes"
  ],
  "title": "RenderTarget",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:RenderTarget:1.0.0"
}
