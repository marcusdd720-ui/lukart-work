{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AI"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "description": "A source location must be nonempty and address immutable source bytes.",
      "properties": {
        "unit": {
          "enum": [
            "PAGE",
            "PARAGRAPH",
            "ARTICLE",
            "BYTE_RANGE",
            "RECORD"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "fragment_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Hash",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "value",
        "fragment_hash"
      ],
      "title": "Locator",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "document_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Hash",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        }
      },
      "required": [
        "document_id",
        "document_hash",
        "locator"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "media_type": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "object_key": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Object Key",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "retention_policy": {
          "$ref": "#/$defs/VersionPin"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "case_id",
        "content_hash",
        "media_type",
        "byte_length",
        "object_key",
        "received_at",
        "actor",
        "retention_policy"
      ],
      "title": "SourceDocument",
      "type": "object"
    },
    "VersionPin": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "title": "VersionPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "urn:lukart:work:FinalSourcesRecord:1.0.0",
      "title": "Contract",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceDocument"
      },
      "title": "Sources",
      "type": "array"
    },
    "anchors": {
      "items": {
        "$ref": "#/$defs/SourceAnchor"
      },
      "title": "Anchors",
      "type": "array"
    }
  },
  "required": [
    "contract",
    "sources",
    "anchors"
  ],
  "title": "FinalSourcesRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lukart:work:FinalSourcesRecord:1.0.0"
}
